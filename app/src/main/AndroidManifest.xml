<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 采集源、图片、海报全走网络 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 电视盒子也算 Leanback，但同时要在手机上安装，所以不强制声明 -->

    <application
        android:name=".TvBoxApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.TvBoxShell"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:usesCleartextTraffic="true">

        <!-- 首页（启动入口） -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 详情页 -->
        <activity
            android:name=".ui.detail.DetailActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden" />

        <!-- 播放器 -->
        <activity
            android:name=".player.PlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden|density|layoutDirection" />

        <!-- 设置 -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden" />

        <!-- WebView 嗅探 -->
        <activity
            android:name=".parse.WebSniffActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden" />

    </application>

</manifest>
